# ==========================================================
# GTA 6 Dual-Pipeline Auto-Clipper (GLOBAL + TR) Ayarları
# Bu dosyayı kopyalayıp ".env" olarak kaydedin veya Web/Mobil
# paneldeki "Kurulum Sihirbazı" üzerinden doğrudan doldurun.
# ==========================================================

# --- Sunucu ve Zamanlayıcı ---
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=
INTERNAL_SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=10
LIVE_CHECK_INTERVAL_SECONDS=60
MAX_CONCURRENT_LIVE_STREAMS=6

# --- Yapay Zeka (AI) ve Konuşma Çözümleme (Whisper) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_ENABLED=true
WHISPER_MODEL=base

# --- Akıllı Kalite Kapısı (Sessiz / AFK / Boş Koltuk Filtresi) ---
MIN_VIRAL_SCORE=8.0
CLIP_MIN_SECONDS=28
CLIP_MAX_SECONDS=45
MIN_SPEECH_WORDS=8
MIN_NON_SILENT_RATIO=0.25

# --- Günlük YouTube Otopilot Limiti, Planlama ve Kuyruk ---
MAX_DAILY_YOUTUBE_PER_PIPELINE=3
MIN_PUBLISH_INTERVAL_MINUTES=240
MAX_QUEUE_PER_PIPELINE=12
LIVE_SPIKE_COOLDOWN_SECONDS=900
STRICT_GTA6_ONLY=true
YOUTUBE_SCHEDULE_AHEAD=false

# --- Yayın Platformu API Bilgileri (Resmi API'ler) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_DATA_API_KEY=

# --- Telegram Kontrol ve Onay Botu ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- n8n Webhook Entegrasyonu (Opsiyonel) ---
N8N_WEBHOOK_URL=

# --- GLOBAL (İngilizce) Kanal Hesapları ---
YOUTUBE_GLOBAL_CLIENT_SECRETS=credentials/youtube_client_secret.json
INSTAGRAM_GLOBAL_USER_ID=
INSTAGRAM_GLOBAL_ACCESS_TOKEN=

# --- TÜRKİYE (Türkçe) Kanal Hesapları ---
YOUTUBE_TR_CLIENT_SECRETS=credentials/youtube_client_secret.json
INSTAGRAM_TR_USER_ID=
INSTAGRAM_TR_ACCESS_TOKEN=

# --- Ev İnternetinden Instagram Reels Yüklemek İçin Geçici Media ---
# PUBLIC_BASE_URL boşsa ve açık HTTPS tüneliniz yoksa true yapabilirsiniz.
TEMP_PUBLIC_UPLOAD_ENABLED=false
